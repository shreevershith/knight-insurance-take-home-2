# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallback ("default" or empty to disable)
CLAUDE_FALLBACKS=default
LLM_TIMEOUT_SECONDS=180
# Per-task routing (D-31, measured $0.62/submission). Defaults: classify + extract Haiku 5.5,
# transcribe Sonnet 5.5, analyst = CLAUDE_MODEL. Override a tier (e.g. Opus everywhere for comparison):
# LLM_MODEL_TRANSCRIBE=claude-opus-5-5
# LLM_EFFORT_EXTRACT=low
# LLM_CACHE_DIR=llm_cache   # point at an empty dir to measure a run with no cache hits
LLM_ESCALATION_MODEL=claude-opus-5-5
LLM_ESCALATION_EFFORT=medium
DATA_DIR=data
# Default: SQLite under DATA_DIR. Postgres (D-33): create the user and database with
#   powershell -ExecutionPolicy Bypass -File scripts/pg_setup.ps1
# DATABASE_URL=postgresql+psycopg://knight:<password>@localhost:5432/knight
# Tests never use DATABASE_URL; set TEST_DATABASE_URL to run them against Postgres.
RULES_FILE=app/rules/knight_v1.yaml
# docker compose (docker-compose.yml): password for the container's own Postgres. Any long random string.
POSTGRES_PASSWORD=
# APP_PORT=8000   # host port for the container app (use another if a local uvicorn already has 8000)
# Page calls run this many at a time within one job (D-36); 1 = sequential
# LLM_CONCURRENCY=6
# Jobs: "thread" runs them in the web process; "queue" needs `python -m app.worker` (compose sets queue)
# JOB_MODE=thread
# D-51: "graph" = LangGraph runs the stages (checkpoints, review as interrupt/resume); "code" = plain sequence
# PIPELINE_ENGINE=code
# D-51: "langchain" = ChatAnthropic sends model requests; "sdk" = the Anthropic SDK (same request)
# LLM_CLIENT=sdk
# Langfuse tracing (D-52). Tracing is on when both keys are set; leave them empty to turn it off.
# Keys: Langfuse project -> Settings -> API Keys. Base URL: https://cloud.langfuse.com (EU),
# https://us.cloud.langfuse.com (US), or a self-hosted server.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Separates traces by environment in Langfuse (Docker sets "docker" unless you set this)
# LANGFUSE_TRACING_ENVIRONMENT=development
# Send document text and model outputs too (PII-masked). Off by default: only ids, counts, models, tokens, costs.
# LANGFUSE_CAPTURE_CONTENT=false
# Response cache: "on" reuses saved answers to identical model requests (repeatable, free re-runs); "off" sends every
# request live and saves nothing (a live demo)
# LLM_CACHE=on
