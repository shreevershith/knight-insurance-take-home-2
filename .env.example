# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallback ("default" or empty to disable)
CLAUDE_FALLBACKS=default
LLM_TIMEOUT_SECONDS=180
# Per-task routing (D-31, measured $0.62/submission). Defaults: classify + extract Haiku 5.5,
# transcribe Sonnet 5.5, analyst = CLAUDE_MODEL. Override a tier (e.g. Opus everywhere for comparison):
# LLM_MODEL_TRANSCRIBE=claude-opus-5-5
# LLM_EFFORT_EXTRACT=low
# LLM_CACHE_DIR=llm_cache   # point at an empty dir to measure a run with no cache hits
LLM_ESCALATION_MODEL=claude-opus-5-5
LLM_ESCALATION_EFFORT=medium
DATA_DIR=data
# Default: SQLite under DATA_DIR. Postgres (D-33): create the user and database with
#   powershell -ExecutionPolicy Bypass -File scripts/pg_setup.ps1
# DATABASE_URL=postgresql+psycopg://knight:<password>@localhost:5432/knight
# Tests never use DATABASE_URL; set TEST_DATABASE_URL to run them against Postgres.
RULES_FILE=app/rules/knight_v1.yaml
